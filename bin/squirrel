#!/usr/bin/env python3
"""Launcher for the squirrel package. The shell functions call this file.

It puts the folder above bin/ on sys.path, so the package is found without
installing anything and without depending on the current directory.
"""
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.realpath(__file__))))

from squirrel.cli import main  # noqa: E402

sys.exit(main())
